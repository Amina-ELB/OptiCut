        <Attribute Name="disp" AttributeType="Vector" Center="Node">
          <DataItem Dimensions="9599 3" Format="HDF">level_set.h5:/Function/disp/0</DataItem>
        </Attribute>
      </Grid>
      <Grid Name="disp" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="1" />
        <Attribute Name="disp" AttributeType="Vector" Center="Node">
          <DataItem Dimensions="9599 3" Format="HDF">level_set.h5:/Function/disp/1</DataItem>
        </Attribute>
      </Grid>
    </Grid>
    <Grid Name="dual" GridType="Collection" CollectionType="Temporal">
      <Grid Name="dual" GridType="Uniform">
        <xi:include xpointer="xpointer(/Xdmf/Domain/Grid[@GridType='Uniform'][1]/*[self::Topology or self::Geometry])" />
        <Time Value="0" />
        <Attribute Name="dual" AttributeType="Vector" Center="Node">
          <DataItem Dimensions="9599 3" Format="HDF">level_set.h5:/Function/dual/0</DataItem>
        </Attribute>
      </Grid>
      <Grid Name="dual" GridType="Uniform">
